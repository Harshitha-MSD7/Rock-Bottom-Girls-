# Copy to .env.local and fill in your Supabase project's client connection values.
# Only a publishable key belongs here. Never use a service-role/secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Address of the Express backend (backend/). No trailing slash.
# Android emulator: http://10.0.2.2:4000   Real phone: http://<your laptop's Wi-Fi IP>:4000
EXPO_PUBLIC_API_URL=
