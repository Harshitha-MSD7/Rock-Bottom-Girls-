# Copy to backend/.env and fill in. Backend only: never put these in the app.

# Supabase > Connect > Connection string > "Transaction pooler" (port 6543).
# Use this one, not the session pooler on 5432: that allows only 15 connections
# in total across every teammate, and fails with "max clients reached".
# Replace [YOUR-PASSWORD] with the database password; write @ in it as %40.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:6543/postgres

# Optional: path to the CA certificate from Supabase > Database > Settings > SSL.
# Certificates are ALWAYS verified. Set this when Supabase uses a private CA.
# DATABASE_CA_FILE=./supabase-ca.crt

# Same values the app uses in frontend/.env.local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Watches. The key is the watch's product ID (PRODUCT_ID in careQ/.env), for
# example "00000001". The watch sends it in the X-Device-Id header.
# - DEVICE_SECRETS_JSON: product ID -> that watch's secret (32+ characters). The
#   same secret goes on the watch. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - DEVICE_PAIRING_CODES_JSON: product ID -> the code a caregiver types in the
#   Pair tab, together with the product ID, to claim that watch.
# A watch must appear in both to be paired.
DEVICE_SECRETS_JSON={}
DEVICE_PAIRING_CODES_JSON={}

# The board's own program sends its product ID and position with no secret.
# Set this to false to accept that. Anyone on the same network could then send
# positions for a paired watch, so only do it on a network you control.
# WATCH_SECRET_REQUIRED=false

# Needed only for recorded messages. Supabase > Project Settings > API Keys >
# Secret key (starts with sb_secret_). Server only: never put it in the app or
# on the watch. Without it, uploading a recording answers 503.
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional: path to an ffmpeg program. One is bundled, so leave this unset.
# FFMPEG_PATH=

PORT=4000

# Optional, only if enhanced push security is enabled on the Expo account.
# EXPO_ACCESS_TOKEN=

# Public Nominatim: one backend process, cached and limited to one lookup/second.
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=careQ/1.0 (your-team-contact)
