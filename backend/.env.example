# Copy to backend/.env and fill in. Backend only: never put these in the app.

# Supabase > Connect > Connection string > "Session pooler" (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with the database password chosen when the project was created.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

# Optional: path to the CA certificate from Supabase > Database > Settings > SSL.
# Certificates are ALWAYS verified. Set this when Supabase uses a private CA.
# DATABASE_CA_FILE=./supabase-ca.crt

# Same values the app uses in frontend/.env.local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Watch credentials: {"<devices.id UUID>": "<random secret, 32+ characters>"}.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRETS_JSON={}

PORT=4000

# Optional, only if enhanced push security is enabled on the Expo account.
# EXPO_ACCESS_TOKEN=

# Public Nominatim: one backend process, cached and limited to one lookup/second.
# GEOCODING_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_USER_AGENT=careQ/1.0 (your-team-contact)
